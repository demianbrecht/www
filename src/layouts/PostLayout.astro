---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import { postUrl, tagUrl, formatDate, isoDate, readingTime } from '../utils';

interface Props {
  post: CollectionEntry<'posts'>;
  prev?: CollectionEntry<'posts'>;
  next?: CollectionEntry<'posts'>;
}

const { post, prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, tags, draft, heroImage, heroImageAlt } = post.data;
---

<BaseLayout {title} {description} type="article" publishedDate={pubDate} image={heroImage}>
  <div class="wrap">
    <article>
      <header class="post-header">
        {draft && (
          <div class="draft-banner">
            [!] draft — not included in production builds
          </div>
        )}

        <h1>{title}</h1>
        <p class="description">{description}</p>

        <div class="post-meta">
          <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
          <span class="sep">/</span>
          <span>{readingTime(post.body)}</span>
          {updatedDate && (
            <>
              <span class="sep">/</span>
              <span>updated <time datetime={isoDate(updatedDate)}>{formatDate(updatedDate)}</time></span>
            </>
          )}
        </div>

        {tags.length > 0 && (
          <div class="tag-row" style="margin-top: 1rem">
            {tags.map((tag) => <a class="tag" href={tagUrl(tag)}>{tag}</a>)}
          </div>
        )}
      </header>

      {heroImage && (
        <Image
          class="hero-image"
          src={heroImage}
          alt={heroImageAlt ?? title}
          widths={[480, 800, 1200]}
          sizes="(max-width: 800px) 100vw, 800px"
          loading="eager"
        />
      )}

      <div class="prose">
        <slot />
      </div>

      {/* Omitted entirely for a lone post — the footer draws a rule, and an
          empty one leaves a divider with nothing beneath it. */}
      {(prev || next) && (
        <footer class="post-footer">
          <nav class="post-nav" aria-label="More posts">
            {next ? (
              <a href={postUrl(next.id)}>
                <span class="dir">&larr; newer</span>
                {next.data.title}
              </a>
            ) : <span />}
            {prev ? (
              <a href={postUrl(prev.id)} style="text-align: right">
                <span class="dir">older &rarr;</span>
                {prev.data.title}
              </a>
            ) : <span />}
          </nav>
        </footer>
      )}
    </article>
  </div>
</BaseLayout>
