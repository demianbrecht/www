---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import OriginalPublication from '../components/OriginalPublication.astro';
import Giscus from '../components/Giscus.astro';
import ShareBar from '../components/ShareBar.astro';
import { postUrl, tagUrl, formatDate, isoDate, readingTime } from '../utils';

interface SeriesPresentation {
  id: string;
  title: string;
  part: number;
  total: number;
}

interface Props {
  post: CollectionEntry<'posts'>;
  prev?: CollectionEntry<'posts'>;
  next?: CollectionEntry<'posts'>;
  series?: SeriesPresentation;
  prevLabel?: string;
  nextLabel?: string;
}

const { post, prev, next, series, prevLabel = 'older', nextLabel = 'newer' } = Astro.props;
const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  draft,
  heroImage,
  heroImageAlt,
  originallyPublished,
} = post.data;

// Absolute canonical URL for share links (matches BaseHead's derivation).
const shareUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<BaseLayout {title} {description} type="article" publishedDate={pubDate} image={heroImage}>
  <div class="wrap">
    <article>
      <header class="post-header">
        {draft && (
          <div class="draft-banner">
            [!] draft — not included in production builds
          </div>
        )}

        <h1>{title}</h1>
        <p class="description">{description}</p>

        {series && (
          <p class="series-meta">
            {series.title} / part {series.part} of {series.total}
          </p>
        )}

        <div class="post-meta">
          <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
          <span class="sep">/</span>
          <span>{readingTime(post.body)}</span>
          {updatedDate && (
            <>
              <span class="sep">/</span>
              <span>updated <time datetime={isoDate(updatedDate)}>{formatDate(updatedDate)}</time></span>
            </>
          )}
        </div>

        {tags.length > 0 && (
          <div class="tag-row" style="margin-top: 1rem">
            {tags.map((tag) => <a class="tag" href={tagUrl(tag, import.meta.env.BASE_URL)}>{tag}</a>)}
          </div>
        )}

        <ShareBar url={shareUrl} title={title} />
      </header>

      {heroImage && (
        <Image
          class="hero-image"
          src={heroImage}
          alt={heroImageAlt ?? title}
          widths={[480, 800, 1200]}
          sizes="(max-width: 800px) 100vw, 800px"
          loading="eager"
        />
      )}

      <div class="prose">
        <slot />
      </div>

      <footer class="post-footer">
        <OriginalPublication publication={originallyPublished} />
        {(prev || next) && (
          <nav class="post-nav" aria-label="More posts">
            {next ? (
              <a class="signal-link" href={postUrl(next.id, import.meta.env.BASE_URL)}>
                <span class="dir">&larr; {nextLabel}</span>
                {next.data.title}
              </a>
            ) : <span />}
            {prev ? (
              <a class="signal-link" href={postUrl(prev.id, import.meta.env.BASE_URL)} style="text-align: right">
                <span class="dir">{prevLabel} &rarr;</span>
                {prev.data.title}
              </a>
            ) : <span />}
          </nav>
        )}
      </footer>

      <Giscus />
    </article>
  </div>
</BaseLayout>

<style>
  .series-meta {
    margin: 0.75rem 0 0;
    color: var(--accent-hover);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  :global(.post-footer .attribution) {
    margin: 0 0 1.25rem;
    color: var(--text-dim);
    font-size: 0.9rem;
  }
</style>
