---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_TITLE, SITE_TAGLINE } from '../consts';
import { isVisible, byNewest } from '../utils';

const posts = (await getCollection('posts', isVisible)).sort(byNewest);
---

<BaseLayout>
  <div class="wrap">
    <section class="hero">
      <h1>{SITE_TITLE}</h1>
      <p class="tagline">{SITE_TAGLINE}</p>
    </section>

    {posts.length === 0 ? (
      <p class="empty-state">
        No posts yet.
      </p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li><PostCard {post} /></li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>
