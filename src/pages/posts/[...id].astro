---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { buildEntryIndex, isVisible } from '../../utils';
import {
  buildTimeline,
  orderPostsForNavigation,
  seriesMetadata,
} from '../../timeline';

interface SeriesPresentation {
  id: string;
  title: string;
  part: number;
  total: number;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const visiblePosts = await getCollection('posts', isVisible);
  const entryIds = buildEntryIndex(visiblePosts);
  const seriesEntries = (await getCollection('series')).map(seriesMetadata);
  const posts = orderPostsForNavigation(visiblePosts, seriesEntries);
  const timeline = buildTimeline(posts, seriesEntries);
  const seriesByPost = new Map<string, SeriesPresentation>();

  for (const item of timeline) {
    if (item.type !== 'series') continue;
    item.members.forEach(({ post, part }) => {
      seriesByPost.set(post.id, {
        id: item.series.id,
        title: item.series.title,
        part,
        total: item.series.posts.length,
      });
    });
  }

  // Sorted newest-first: index+1 is older, index-1 is newer.
  return posts.map((post, i) => {
    const currentSeries = seriesByPost.get(post.id);
    const prevSeries = posts[i + 1] ? seriesByPost.get(posts[i + 1].id) : undefined;
    const nextSeries = posts[i - 1] ? seriesByPost.get(posts[i - 1].id) : undefined;

    return {
      params: { id: post.id },
      props: {
        post,
        entryId: entryIds.get(post.id),
        prev: posts[i + 1],
        next: posts[i - 1],
        series: currentSeries,
        prevLabel: currentSeries?.id === prevSeries?.id ? 'next part' : 'older',
        nextLabel: currentSeries?.id === nextSeries?.id ? 'previous part' : 'newer',
      },
    };
  });
};

interface Props {
  post: CollectionEntry<'posts'>;
  entryId: string;
  prev?: CollectionEntry<'posts'>;
  next?: CollectionEntry<'posts'>;
  series?: SeriesPresentation;
  prevLabel: string;
  nextLabel: string;
}

const { post, entryId, prev, next, series, prevLabel, nextLabel } = Astro.props as Props;
const { Content } = await render(post);
---

<PostLayout {post} {entryId} {prev} {next} {series} {prevLabel} {nextLabel}>
  <Content />
</PostLayout>
