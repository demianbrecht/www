---
import { AUTHOR } from '../consts';
import { url } from '../utils';

// Build-time constant — the year the site was last built.
const year = new Date().getFullYear();
const baseUrl = import.meta.env.BASE_URL;
---

<footer class="site-footer">
  <div class="wrap">
    <span>&copy; {year} {AUTHOR}</span>
    <span>
      <a class="signal-link" href={url('rss.xml', baseUrl)}>rss</a> &middot;
      <a class="signal-link" href={url('archive', baseUrl)}>archive</a>
    </span>
  </div>
</footer>
