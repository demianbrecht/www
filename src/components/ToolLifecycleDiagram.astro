<figure class="lifecycle" aria-labelledby="lifecycle-title" aria-describedby="lifecycle-caption">
  <div class="figure-title" id="lifecycle-title">Two tool interfaces, two lifecycles</div>

  <div class="lanes">
    <section class="lane" aria-labelledby="ephemeral-title">
      <header class="lane-heading">
        <span class="lane-marker" aria-hidden="true"></span>
        <div>
          <h4 id="ephemeral-title">Ephemeral</h4>
          <p>One continuous request</p>
        </div>
      </header>

      <ol class="steps steps-ephemeral" aria-label="Prompt, then tool call, then result">
        <li class="step"><span>Prompt</span></li>
        <li class="step"><span>Tool call</span></li>
        <li class="step step-terminal"><span>Result</span></li>
      </ol>
    </section>

    <section class="lane" aria-labelledby="durable-title">
      <header class="lane-heading">
        <span class="lane-marker" aria-hidden="true"></span>
        <div>
          <h4 id="durable-title">Durable</h4>
          <p>Revisited across requests</p>
        </div>
      </header>

      <div class="durable-flow">
        <ol
          class="steps steps-durable"
          aria-label="Prompt, create, task ID, repeated status checks, optional preview, then commit"
        >
          <li class="step"><span>Prompt</span></li>
          <li class="step"><span>Create</span></li>
          <li class="step"><span>Task ID</span></li>
          <li class="step step-get">
            <span>Get</span>
            <small><span class="loop-mark" aria-hidden="true">↻</span> while running</small>
          </li>
          <li class="step step-optional">
            <span>Preview</span>
            <small>if needed</small>
          </li>
          <li class="step step-terminal"><span>Commit</span></li>
        </ol>

        <div
          class="persisted-state"
          role="group"
          aria-label="The task is persisted from creation until commit or cancel"
        >
          <span class="persisted-end">Create</span>
          <span class="persisted-line" aria-hidden="true"></span>
          <span class="persisted-label">persisted operation</span>
          <span class="persisted-line" aria-hidden="true"></span>
          <span class="persisted-end">Commit or cancel</span>
        </div>

        <div
          class="cancel-branch"
          role="group"
          aria-label="Cancel is an alternate exit while the operation is active"
        >
          <span class="branch-arrow" aria-hidden="true">↳</span>
          <span class="cancel-step">Cancel</span>
          <span class="branch-label">alternate exit while active</span>
        </div>
      </div>
    </section>
  </div>

  <figcaption id="lifecycle-caption">
    Immediate work completes inside one request. Durable work returns a task ID that can be checked,
    optionally previewed, committed, or cancelled later.
  </figcaption>
</figure>

