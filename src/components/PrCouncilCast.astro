---
import { prCouncilCast, prCouncilCastDuration } from '../data/prCouncilCast';
---

<figure class="council-cast" data-pr-council-cast>
  <div class="cast-header">
    <div class="cast-identity">
      <span class="cast-mark" aria-hidden="true">›_</span>
      <div>
        <span class="cast-kicker">PR COUNCIL / CLAUDE CODE</span>
        <strong>Review lifecycle</strong>
      </div>
    </div>
    <span class="cast-badge">ILLUSTRATIVE REPLAY</span>
  </div>

  <div class="cast-screen" aria-hidden="true">
    <div class="cast-output" data-cast-output>
      <span class="cast-line tone-shell">{prCouncilCast[0].text}</span>
    </div>
  </div>

  <div class="cast-controls" data-cast-controls hidden>
    <button type="button" class="cast-button" data-cast-toggle aria-label="Play recording">Play</button>
    <button type="button" class="cast-button cast-replay" data-cast-replay aria-label="Replay recording">↺</button>
    <input
      type="range"
      min="0"
      max={prCouncilCastDuration}
      step="0.1"
      value="0"
      aria-label="Seek recording"
      data-cast-progress
    />
    <span class="cast-clock" data-cast-clock>0:00 / 0:30</span>
  </div>

  <figcaption>
    An illustrative, time-compressed session based on the PR Council MCP tool flow. The PR and findings are fictional.
  </figcaption>

  <details class="cast-transcript">
    <summary>Read the full transcript</summary>
    <pre>{prCouncilCast.map((event) => event.text).join('\n')}</pre>
  </details>
</figure>

<script>
  import { prCouncilCast, prCouncilCastDuration } from '../data/prCouncilCast';

  const player = document.querySelector<HTMLElement>('[data-pr-council-cast]');

  if (player) {
    const output = player.querySelector<HTMLElement>('[data-cast-output]');
    const controls = player.querySelector<HTMLElement>('[data-cast-controls]');
    const toggle = player.querySelector<HTMLButtonElement>('[data-cast-toggle]');
    const replay = player.querySelector<HTMLButtonElement>('[data-cast-replay]');
    const progress = player.querySelector<HTMLInputElement>('[data-cast-progress]');
    const clock = player.querySelector<HTMLElement>('[data-cast-clock]');
    const screen = player.querySelector<HTMLElement>('.cast-screen');

    if (output && controls && toggle && replay && progress && clock && screen) {
      let currentTime = 0;
      let playing = false;
      let inView = false;
      let autoStarted = false;
      let lastTick = 0;
      let animationFrame = 0;
      let rendered = '';

      const formatTime = (seconds: number) => `0:${String(Math.floor(seconds)).padStart(2, '0')}`;

      function render() {
        const visible = prCouncilCast.flatMap((event) => {
          if (event.at > currentTime) return [];
          const text = event.typeDuration
            ? event.text.slice(0, Math.min(event.text.length, Math.ceil(
                ((currentTime - event.at) / event.typeDuration) * event.text.length,
              )))
            : event.text;
          return text ? [{ text, tone: event.tone }] : [];
        });
        const signature = visible.map((line) => line.text).join('\n');

        if (signature !== rendered) {
          const lines = document.createDocumentFragment();
          for (const line of visible) {
            const span = document.createElement('span');
            span.className = `cast-line tone-${line.tone}`;
            span.textContent = line.text;
            lines.append(span);
          }
          output!.replaceChildren(lines);
          screen!.scrollTop = screen!.scrollHeight;
          rendered = signature;
        }

        progress!.value = String(currentTime);
        progress!.style.setProperty('--cast-progress', `${(currentTime / prCouncilCastDuration) * 100}%`);
        clock!.textContent = `${formatTime(currentTime)} / ${formatTime(prCouncilCastDuration)}`;
        toggle!.textContent = playing ? 'Pause' : currentTime >= prCouncilCastDuration ? 'Replay' : 'Play';
        toggle!.setAttribute('aria-label', toggle!.textContent + ' recording');
      }

      function tick(now: number) {
        animationFrame = 0;
        if (!playing || !inView || document.hidden) return;
        if (lastTick) currentTime = Math.min(prCouncilCastDuration, currentTime + (now - lastTick) / 1000);
        lastTick = now;
        if (currentTime >= prCouncilCastDuration) playing = false;
        render();
        if (playing) animationFrame = requestAnimationFrame(tick);
      }

      function schedule() {
        lastTick = 0;
        if (playing && inView && !document.hidden && !animationFrame) {
          animationFrame = requestAnimationFrame(tick);
        }
      }

      function play() {
        if (currentTime >= prCouncilCastDuration) currentTime = 0;
        playing = true;
        render();
        schedule();
      }

      function pause() {
        playing = false;
        lastTick = 0;
        if (animationFrame) cancelAnimationFrame(animationFrame);
        animationFrame = 0;
        render();
      }

      toggle.addEventListener('click', () => playing ? pause() : play());
      replay.addEventListener('click', () => {
        currentTime = 0;
        play();
      });
      progress.addEventListener('input', () => {
        currentTime = Number(progress.value);
        render();
        schedule();
      });
      document.addEventListener('visibilitychange', schedule);

      const observer = new IntersectionObserver((entries) => {
        inView = entries[0]?.isIntersecting ?? false;
        if (inView && !autoStarted) {
          autoStarted = true;
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            currentTime = prCouncilCastDuration;
            render();
          } else {
            play();
          }
        }
        schedule();
      }, { threshold: 0.25 });
      observer.observe(player);

      controls.hidden = false;
      render();
    }
  }
</script>

<style>
  .council-cast {
    margin: 0 0 2.5rem;
    overflow: hidden;
    border: 1px solid var(--border-lit);
    border-radius: var(--radius);
    background: var(--bg-raised);
    box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 16%);
  }

  .cast-header,
  .cast-identity,
  .cast-controls { display: flex; align-items: center; }

  .cast-header {
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-inset);
  }

  .cast-identity { gap: 0.75rem; min-width: 0; }

  .cast-mark {
    display: grid;
    flex: none;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--border-lit);
    border-radius: var(--radius);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.95rem;
  }

  .cast-identity div { display: grid; gap: 0.05rem; min-width: 0; }
  .cast-kicker,
  .cast-badge,
  .cast-identity strong,
  .cast-controls,
  .cast-transcript { font-family: var(--font-mono); }

  .cast-kicker {
    color: var(--accent);
    font-size: 0.62rem;
    letter-spacing: 0.09em;
  }

  .cast-identity strong { color: var(--text); font-size: 0.82rem; font-weight: 600; }

  .cast-badge {
    color: var(--text-fainter);
    font-size: 0.62rem;
    letter-spacing: 0.05em;
    text-align: right;
  }

  .cast-screen {
    height: 20rem;
    padding: 1rem 1.1rem;
    overflow: auto;
    background:
      linear-gradient(180deg, rgb(98 255 198 / 2%), transparent 25%),
      #101318;
    scrollbar-color: var(--border-lit) transparent;
  }

  .cast-output {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.65;
    font-variant-ligatures: none;
  }

  .cast-output :global(.cast-line) {
    display: block;
    min-height: 1.65em;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: var(--text-dim);
  }

  .cast-output :global(.tone-shell) { color: var(--text-fainter); }
  .cast-output :global(.tone-prompt) { color: var(--text); }
  .cast-output :global(.tone-tool) { color: var(--accent); }
  .cast-output :global(.tone-status) { color: var(--text-dim); }
  .cast-output :global(.tone-finding) { color: var(--status-warn); }
  .cast-output :global(.tone-note) { color: var(--text); }

  .cast-controls {
    gap: 0.65rem;
    padding: 0.55rem 0.9rem;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .cast-controls[hidden] { display: none; }

  .cast-button {
    flex: none;
    min-width: 3.3rem;
    padding: 0.2rem 0.4rem;
    border: 1px solid var(--border-lit);
    border-radius: var(--radius);
    background: var(--bg-inset);
    color: var(--text);
    font: inherit;
    font-size: 0.7rem;
    cursor: pointer;
  }

  .cast-button:hover,
  .cast-button:focus-visible { border-color: var(--accent); color: var(--accent); }
  .cast-replay { min-width: 1.75rem; font-size: 1rem; line-height: 1; }

  .cast-controls input {
    width: 100%;
    min-width: 2rem;
    height: 0.85rem;
    margin: 0;
    appearance: none;
    background: transparent;
    cursor: pointer;
  }

  .cast-controls input::-webkit-slider-runnable-track {
    height: 0.22rem;
    border-radius: 1rem;
    background: linear-gradient(to right, var(--accent) var(--cast-progress, 0%), var(--border-lit) var(--cast-progress, 0%));
  }

  .cast-controls input::-moz-range-track { height: 0.22rem; border-radius: 1rem; background: var(--border-lit); }
  .cast-controls input::-moz-range-progress { height: 0.22rem; border-radius: 1rem; background: var(--accent); }
  .cast-controls input::-webkit-slider-thumb {
    width: 0.75rem;
    height: 0.75rem;
    margin-top: -0.27rem;
    appearance: none;
    border: 0;
    border-radius: 50%;
    background: var(--accent);
  }
  .cast-controls input::-moz-range-thumb { width: 0.75rem; height: 0.75rem; border: 0; border-radius: 50%; background: var(--accent); }
  .cast-controls input:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .cast-clock { flex: none; color: var(--text-fainter); font-size: 0.68rem; font-variant-numeric: tabular-nums; }

  .council-cast figcaption {
    margin: 0;
    padding: 0.7rem 0.9rem 0.2rem;
    color: var(--text-fainter);
    font-size: 0.76rem;
    line-height: 1.5;
  }

  .cast-transcript { padding: 0.25rem 0.9rem 0.75rem; color: var(--text-dim); font-size: 0.72rem; }
  .cast-transcript summary { width: max-content; max-width: 100%; cursor: pointer; }
  .cast-transcript summary:hover { color: var(--accent); }
  .cast-transcript pre {
    max-height: 18rem;
    margin: 0.6rem 0 0;
    padding: 0.8rem;
    overflow: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text-dim);
    font: inherit;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  @media (max-width: 34rem) {
    .cast-header { align-items: flex-start; }
    .cast-badge { max-width: 6rem; line-height: 1.3; }
    .cast-screen { height: 22rem; padding: 0.8rem; }
    .cast-output { font-size: 0.72rem; }
    .cast-controls { gap: 0.4rem; padding: 0.55rem; }
    .cast-clock { font-size: 0.61rem; }
  }
</style>
