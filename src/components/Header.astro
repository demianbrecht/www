---
import { SITE_TITLE, NAV_LINKS } from '../consts';
import { url } from '../utils';
import SiteTitle from './SiteTitle.astro';

/** Current path with base and trailing slash stripped, for nav highlighting. */
const current =
  Astro.url.pathname.replace(import.meta.env.BASE_URL, '').replace(/\/$/, '') || '/';
const baseUrl = import.meta.env.BASE_URL;
---

<header class="site-header">
  <div class="wrap">
    <a class="brand signal-link" href={url('/', baseUrl)} aria-label={SITE_TITLE}>
      <SiteTitle />
    </a>
    <nav class="site-nav" aria-label="Main">
      {NAV_LINKS.map(({ href, label, featured }) => {
        const target = href.replace(/\/$/, '') || '/';
        const isCurrent = target === '/'
          ? current === '/'
          : current === target || current.startsWith(`${target}/`);
        const burnoutIndex = featured ? label.indexOf('e') : -1;
        return (
          <a
            class:list={['signal-link', { 'start-here-link': featured }]}
            href={url(href, baseUrl)}
            aria-current={isCurrent ? 'page' : undefined}
            aria-label={featured ? label : undefined}
          >
            {featured ? (
              <span aria-hidden="true">
                {label.slice(0, burnoutIndex)}<span class="burnout-letter start-here-burnout">{label[burnoutIndex]}</span>{label.slice(burnoutIndex + 1)}
              </span>
            ) : label}
          </a>
        );
      })}
    </nav>
  </div>
</header>
