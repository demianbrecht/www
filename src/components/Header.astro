---
import { SITE_TITLE, NAV_LINKS } from '../consts';
import { url } from '../utils';
import SiteTitle from './SiteTitle.astro';
import NewsletterSignup from './NewsletterSignup.astro';

/** Current path with base and trailing slash stripped, for nav highlighting. */
const current =
  Astro.url.pathname.replace(import.meta.env.BASE_URL, '').replace(/\/$/, '') || '/';
const baseUrl = import.meta.env.BASE_URL;
---

<header class="site-header">
  <div class="wrap">
    <a class="brand signal-link" href={url('/', baseUrl)} aria-label={SITE_TITLE}>
      <SiteTitle />
    </a>
    <nav class="site-nav" aria-label="Main">
      {NAV_LINKS.map(({ href, label }) => {
        const target = href.replace(/\/$/, '') || '/';
        const isCurrent = target === '/'
          ? current === '/'
          : current === target || current.startsWith(`${target}/`);
        return (
          <a class="signal-link" href={url(href, baseUrl)} aria-current={isCurrent ? 'page' : undefined}>
            {label}
          </a>
        );
      })}
    </nav>
  </div>
  <NewsletterSignup />
</header>
